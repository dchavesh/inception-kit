#!/usr/bin/env python3
"""Close — muestra determinista para la auditoría de afirmaciones.

Sortea (con semilla, reproducible) una muestra de afirmaciones del report
vigente, extrae los pares afirmación↔fuente y agrupa dominios/orígenes
repetidos como candidatos a eco. El juicio (¿la fuente existe y dice eso?) va
en la skill `/close`, no acá.

Uso: claim-audit-sample UNIT_ID [--sample N] [--seed S]
"""
import random
import re
import sys
from collections import defaultdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kitlib import config as kitconfig
from kitlib import report as spec
from kitlib.errors import fail
from kitlib.ids import find_unit_dir, is_valid_unit_id, latest_artifact, sub_id_pattern
from kitlib.md import list_items, parse_frontmatter, section, table_rows

DEFAULT_SAMPLE = 10
DEFAULT_SEED = 1
DOMAIN_RE = re.compile(r"https?://(?:www\.)?([^/\s|)]+)")
ORIGIN_COLUMN = 2  # `Autor/Org` en la tabla de fuentes


def parse_args(argv: list[str]) -> tuple[list[str], int, int]:
    positional, flags = [], {"--sample": DEFAULT_SAMPLE, "--seed": DEFAULT_SEED}
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg in flags:
            try:
                flags[arg] = int(argv[index + 1])
            except (IndexError, ValueError):
                fail(f"{arg} requiere un entero")
            index += 2
        elif arg.startswith("--"):
            fail(f"flag desconocida: {arg}")
        else:
            positional.append(arg)
            index += 1
    return positional, flags["--sample"], flags["--seed"]


def extract_claims(body: str, src_pattern) -> list[tuple[str, list[str]]]:
    claims_section = section(body, spec.CLAIMS_SECTION)
    if not claims_section:
        fail(f"report sin sección {spec.CLAIMS_SECTION} "
             f"({spec.SECTION_KEYWORDS[spec.CLAIMS_SECTION]})")
    return [(item, src_pattern.findall(item)) for item in list_items(claims_section)]


def extract_sources(body: str, src_pattern) -> dict[str, list[str]]:
    sources_section = section(body, spec.SOURCES_SECTION)
    if not sources_section:
        fail(f"report sin sección {spec.SOURCES_SECTION} "
             f"({spec.SECTION_KEYWORDS[spec.SOURCES_SECTION]})")
    sources = {}
    for row in table_rows(sources_section)[1:]:
        if row and src_pattern.match(row[0]):
            sources[row[0]] = row
    return sources


def echo_groups(sources: dict[str, list[str]]) -> dict[str, list[str]]:
    groups = defaultdict(list)
    for src_id, row in sources.items():
        line = " | ".join(row)
        domain = DOMAIN_RE.search(line)
        if domain:
            groups[f"dominio:{domain.group(1).lower()}"].append(src_id)
        if len(row) > ORIGIN_COLUMN and row[ORIGIN_COLUMN]:
            groups[f"origen:{row[ORIGIN_COLUMN].lower()}"].append(src_id)
    return {key: value for key, value in groups.items() if len(value) > 1}


def main() -> None:
    config = kitconfig.load()
    positional, sample_size, seed = parse_args(sys.argv[1:])
    if len(positional) != 1 or not is_valid_unit_id(config, positional[0]):
        fail("uso: claim-audit-sample UNIT_ID [--sample N] [--seed S]")
    unit_id = positional[0]

    report = latest_artifact(find_unit_dir(config, unit_id), "01-report")
    if not report.exists():
        fail(f"{config.relative(report)}: no existe — nada que auditar")
    _, body = parse_frontmatter(report.read_text(encoding="utf-8"))
    src_pattern = sub_id_pattern(config, "src", unit_id)
    claims = extract_claims(body, src_pattern)
    sources = extract_sources(body, src_pattern)
    if not claims:
        fail(f"sección {spec.CLAIMS_SECTION} sin afirmaciones en formato de lista")

    rng = random.Random(f"{unit_id}:{seed}")
    sampled = sorted(rng.sample(range(len(claims)), min(sample_size, len(claims))))
    print(f"# Muestra de auditoría — {unit_id} · {len(sampled)}/{len(claims)} "
          f"afirmaciones · seed {seed} (determinista)\n")
    for index in sampled:
        text, src_ids = claims[index]
        print(f"## Afirmación #{index + 1}")
        print(f"> {text}")
        if not src_ids:
            print("· SIN FUENTE — especulativa por definición; verificar etiqueta.")
        for src_id in src_ids:
            row = sources.get(src_id)
            print(f"· {src_id}: {' | '.join(row) if row else 'NO ESTÁ EN LA TABLA DE FUENTES'}")
        print()

    print("# Candidatos a eco (agrupación mecánica — el juicio va en `/close` paso 2)\n")
    groups = echo_groups(sources)
    if not groups:
        print("Sin dominios ni orígenes repetidos en la tabla de fuentes.")
    for key, ids in sorted(groups.items()):
        print(f"· {key}: {', '.join(sorted(ids))}")


if __name__ == "__main__":
    main()
