#!/usr/bin/env python3
"""Close — extracción mecánica de requisitos del report a la RTM del registry.

Modo normal:  extract-registry UNIT_ID [--marks FILE]
  Copia la tabla consolidada del `01-report` vigente a `registry/requirements.md`.
  El archivo de marks (juicio de la skill `/close`, una línea por requisito):

      <unit>-reqNN new
      <unit>-reqNN duplicate:<id>
      <unit>-reqNN contradicts:<id> supersedes:<id>

  Sin marks, todo entra como `new`.
  REGLA DURA: `contradicts` sin `supersedes:` ⇒ rechazo total, no se escribe nada.
  Cada `contradicts` además marca la fila superada (jamás la borra) y anota un
  `con-NN` en `conflicts.md` (solo se anota — se resuelve en la síntesis).

Modo enmienda:  extract-registry --amend RECORD_ID [--date YYYY-MM-DD]
  Propaga marca de invalidación a toda fila de la RTM cuyo Evidence cite el
  record enmendado (spec §0.2 #2).
"""
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kitlib import config as kitconfig
from kitlib import registry as reg
from kitlib import report as spec
from kitlib.dates import today
from kitlib.errors import fail
from kitlib.ids import find_unit_dir, is_valid_unit_id, latest_artifact, sub_id_pattern
from kitlib.md import (is_separator_row, parse_frontmatter, section,
                       split_table_row, table_rows)

RTM_COLUMNS = spec.REQ_COLUMNS + spec.REGISTRY_EXTRA_COLUMNS


def marks_pattern(config) -> re.Pattern:
    req = sub_id_pattern(config, "req").pattern
    return re.compile(
        rf"^(?P<id>{req})\s+(?:(?P<new>{reg.STATUS_NEW})"
        rf"|{reg.STATUS_DUPLICATE}:(?P<duplicate>{req})"
        rf"|{reg.STATUS_CONTRADICTS}:(?P<contradicts>{req})"
        rf"(?:\s+supersedes:(?P<supersedes>{req}))?)\s*$"
    )


def read_report_rows(config, unit_id: str) -> list[list[str]]:
    report = latest_artifact(find_unit_dir(config, unit_id), "01-report")
    if not report.exists():
        fail(f"{config.relative(report)}: no existe")
    _, body = parse_frontmatter(report.read_text(encoding="utf-8"))
    requirements = section(body, spec.REQUIREMENTS_SECTION)
    if not requirements:
        fail(f"report sin sección {spec.REQUIREMENTS_SECTION} "
             f"({spec.SECTION_KEYWORDS[spec.REQUIREMENTS_SECTION]} consolidada de requisitos)")
    rows = table_rows(requirements)[1:]
    if not rows:
        fail(f"sección {spec.REQUIREMENTS_SECTION} sin filas de requisitos")
    for row in rows:
        if len(row) != len(spec.REQ_COLUMNS):
            fail(f"sección {spec.REQUIREMENTS_SECTION}: fila con {len(row)} celdas "
                 f"(esperaba {len(spec.REQ_COLUMNS)}): {row[:1]} — corré `validate-report` primero")
    return rows


def read_marks(config, path: str) -> dict[str, dict]:
    pattern = marks_pattern(config)
    marks = {}
    for line in Path(path).read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        match = pattern.match(stripped)
        if not match:
            fail(f"marks: línea inválida: «{stripped}»\n"
                 f"  gramática: <id> {reg.STATUS_NEW} | {reg.STATUS_DUPLICATE}:<id> | "
                 f"{reg.STATUS_CONTRADICTS}:<id> supersedes:<id>")
        marks[match.group("id")] = match.groupdict()
    return marks


def existing_ids(text: str) -> set[str]:
    ids = set()
    for line in text.splitlines():
        if not line.strip().startswith("|"):
            continue
        cells = split_table_row(line)
        if cells and not is_separator_row(cells) and "-req" in cells[0]:
            ids.add(cells[0])
    return ids


def next_conflict_number(text: str, width: int) -> int:
    numbers = re.findall(rf"\bcon-(\d{{{width},}})\b", text)
    return max((int(number) for number in numbers), default=0) + 1


def status_cell(mark: dict) -> str:
    if mark.get("contradicts"):
        return (f"{reg.STATUS_CONTRADICTS} {mark['contradicts']} · "
                f"supersedes {mark['supersedes']}")
    if mark.get("duplicate"):
        return f"{reg.STATUS_DUPLICATE}: {mark['duplicate']}"
    return reg.STATUS_NEW


def mark_superseded(text: str, target: str, by: str, relative: str) -> str:
    out, touched = [], 0
    for line in text.splitlines():
        cells = split_table_row(line) if line.strip().startswith("|") else []
        if len(cells) == len(RTM_COLUMNS) and cells[0] == target:
            cells = cells[:-2] + [f"{reg.STATUS_SUPERSEDED} {by}", cells[-1]]
            out.append("| " + " | ".join(cells) + " |")
            touched += 1
        else:
            out.append(line)
    if touched == 0:
        fail(f"supersedes {target}: fila no encontrada en {relative}")
    return "\n".join(out) + "\n"


def mode_extract(config, unit_id: str, marks_path: str | None) -> None:
    rows = read_report_rows(config, unit_id)
    marks = read_marks(config, marks_path) if marks_path else {}
    requirements = config.registry_file("requirements")
    relative = config.relative(requirements)
    if not requirements.exists():
        fail(f"{relative}: no existe — correr `kit-init`")
    text = requirements.read_text(encoding="utf-8")
    known = existing_ids(text)

    violations, new_lines, supersede_targets, conflict_notes = [], [], {}, []
    for row in rows:
        req_id = row[0]
        if req_id in known:
            violations.append(f"{req_id}: ya existe en el registry (los IDs son permanentes)")
            continue
        mark = marks.get(req_id, {})
        if mark.get("contradicts") and not mark.get("supersedes"):
            violations.append(f"{req_id}: {reg.STATUS_CONTRADICTS} {mark['contradicts']} "
                              "sin `supersedes:` — rechazado")
            continue
        if mark.get("contradicts"):
            supersede_targets[mark["supersedes"]] = req_id
            conflict_notes.append((req_id, mark["contradicts"]))
        new_lines.append("| " + " | ".join(list(row) + [status_cell(mark), "—"]) + " |")

    unknown = sorted(set(marks) - {row[0] for row in rows})
    for req_id in unknown:
        violations.append(f"{req_id}: marcado pero ausente de la sección "
                          f"{spec.REQUIREMENTS_SECTION} del report")

    if violations:
        for violation in violations:
            print(f"ERROR: {violation}", file=sys.stderr)
        print("Rechazo total: no se escribió nada en el registry.", file=sys.stderr)
        sys.exit(1)

    for target, by in supersede_targets.items():
        text = mark_superseded(text, target, by, relative)
    requirements.write_text(text.rstrip("\n") + "\n" + "\n".join(new_lines) + "\n",
                            encoding="utf-8")
    print(f"{unit_id}: {len(new_lines)} requisito(s) agregados a {relative}")

    if conflict_notes:
        append_conflicts(config, unit_id, conflict_notes)


def append_conflicts(config, unit_id: str, notes: list[tuple[str, str]]) -> None:
    conflicts = config.registry_file("conflicts")
    relative = config.relative(conflicts)
    if not conflicts.exists():
        fail(f"{relative}: no existe — correr `kit-init`")
    text = conflicts.read_text(encoding="utf-8")
    start = next_conflict_number(text, config.id_width)
    rows = []
    for offset, (new_req, old_req) in enumerate(notes):
        con_id = f"con-{start + offset:0{config.id_width}d}"
        old_unit = old_req.split("-")[0]
        rows.append(f"| {con_id} | {unit_id}, {old_unit} | {new_req} ↔ {old_req} "
                    f"| {new_req} {reg.STATUS_CONTRADICTS} {old_req} (supersedes declarado) "
                    f"| — | síntesis | abierto | {today()} |")
    conflicts.write_text(text.rstrip("\n") + "\n" + "\n".join(rows) + "\n", encoding="utf-8")
    print(f"{unit_id}: {len(rows)} conflicto(s) anotados en {relative}")


def mode_amend(config, record_id: str, date: str) -> None:
    requirements = config.registry_file("requirements")
    text = requirements.read_text(encoding="utf-8")
    out, touched = [], 0
    for line in text.splitlines():
        cells = split_table_row(line) if line.strip().startswith("|") else []
        is_data = len(cells) == len(RTM_COLUMNS) and "-req" in cells[0]
        if is_data and record_id in line and cells[0] != record_id:
            cells = cells[:-1] + [f"{reg.STATUS_INVALIDATED}: enmienda a {record_id} ({date})"]
            out.append("| " + " | ".join(cells) + " |")
            touched += 1
        else:
            out.append(line)
    requirements.write_text("\n".join(out) + "\n", encoding="utf-8")
    print(f"enmienda a {record_id}: {touched} fila(s) marcadas como invalidadas")


def main() -> None:
    config = kitconfig.load()
    argv = sys.argv[1:]
    if "--amend" in argv:
        index = argv.index("--amend")
        record = argv[index + 1] if index + 1 < len(argv) else None
        if not record:
            fail("uso: extract-registry --amend RECORD_ID [--date YYYY-MM-DD]")
        date = argv[argv.index("--date") + 1] if "--date" in argv else today()
        mode_amend(config, record, date)
        return
    marks = argv[argv.index("--marks") + 1] if "--marks" in argv else None
    positional = [arg for arg in argv if not arg.startswith("--") and arg != marks]
    if len(positional) != 1 or not is_valid_unit_id(config, positional[0]):
        fail("uso: extract-registry UNIT_ID [--marks FILE] | --amend RECORD_ID")
    mode_extract(config, positional[0], marks)


if __name__ == "__main__":
    main()
