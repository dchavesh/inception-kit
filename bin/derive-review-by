#!/usr/bin/env python3
"""Deriva `review_by` = fecha + horizonte(volatilidad) por hallazgo. Lista vencidos.

`review_by` jamás se almacena (spec §6.1). Horizontes: `framework.config.yaml`
(`horizons`), jamás hardcodeados. Fecha del hallazgo: frontmatter `date` de su
`02-findings` vigente. Volatilidad: la anotación entre paréntesis del hallazgo;
si menciona más de una, rige la más volátil. El cálculo vive en
`kitlib.freshness` — un contrato, un lugar: lo comparten este comando,
`check-recurrence` y el índice.

Exit 0 sin vencidos; exit 1 con vencidos (lo consume el preflight de síntesis).

Uso: derive-review-by
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kitlib import config as kitconfig
from kitlib import freshness
from kitlib.dates import today

TITLE_WIDTH = 60
LABELS = {freshness.STATE_EXPIRED: "VENCIDO",
          freshness.STATE_CURRENT: "vigente",
          freshness.STATE_UNLABELLED: "sin etiqueta"}


def main() -> None:
    config = kitconfig.load()
    now = today()
    summary = " · ".join(f"{word} {months}m" for word, months in config.horizons.items())
    print(f"Horizontes (framework.config.yaml): {summary} · hoy: {now}\n")

    rows = freshness.expiries(config, now)
    if not rows:
        print("Sin findings en el repo todavía.")
        return

    print("| Unit | # | Finding | Date | review_by | State |")
    print("|---|---|---|---|---|---|")
    for row in rows:
        print(f"| {row.unit} | {row.number} | {row.title[:TITLE_WIDTH]} | {row.date} "
              f"| {row.review_by or '—'} | {LABELS[row.state]} |")

    expired = freshness.expired(rows)
    unlabelled = freshness.unlabelled(rows)
    print(f"\nvencidos: {len(expired)} · sin etiqueta de volatilidad: {len(unlabelled)}")
    if expired:
        sys.stdout.flush()  # la tabla sale primero, aunque stdout esté redirigido
        print("Vencido sin re-verificar ⇒ baja un nivel de madurez (spec §6.1): "
              "se refresca o entra degradado — jamás lavado. `check-recurrence` "
              "propone qué relanzar.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
