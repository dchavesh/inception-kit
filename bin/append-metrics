#!/usr/bin/env python3
"""Close — una fila por cierre en el registry de métricas (append-only).

Las columnas NO están hardcodeadas: salen de `metrics.columns` de
`framework.config.yaml`. Si la definición cambió, las filas ya escritas no
calzan con el schema vigente y el script se detiene: reescribir un record
append-only bajo otra definición falsifica la serie — ese cambio lo ejecuta
`/migrate`, jamás una edición.

Escribe en `registry/data/metrics.jsonl` y regenera su vista. Nadie edita el
`.md`: es derivado (spec §12 G6).

Tipos de columna: `percent` (0-100, con o sin `%`, más los `tokens` que la
columna declare, p. ej. `n/a`), `integer`, `text`.

Uso: append-metrics UNIT_ID --<columna> VALOR ... [--date YYYY-MM-DD]
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kitlib import config as kitconfig
from kitlib import registry as reg
from kitlib import registrystore as store
from kitlib.dates import today
from kitlib.errors import fail
from kitlib.ids import is_valid_unit_id

COMMAND = "append-metrics"


def usage(config) -> str:
    flags = " ".join(f"{column.flag} VALOR" for column in config.metric_columns)
    return f"uso: append-metrics UNIT_ID {flags} [--date YYYY-MM-DD]"


def parse_args(argv: list[str]) -> tuple[list[str], dict]:
    flags, positional, index = {}, [], 0
    while index < len(argv):
        if argv[index].startswith("--"):
            if index + 1 >= len(argv):
                fail(f"{argv[index]} requiere valor")
            flags[argv[index]] = argv[index + 1]
            index += 2
        else:
            positional.append(argv[index])
            index += 1
    return positional, flags


def coerce(column, raw: str) -> str:
    if column.kind == "text":
        return raw
    if raw.lower() in {token.lower() for token in column.tokens}:
        return raw.lower()
    if column.kind == "integer":
        if not raw.isdigit():
            fail(f"{column.flag}: '{raw}' no es un entero"
                 + (f" ni {list(column.tokens)}" if column.tokens else ""))
        return raw
    try:
        value = float(raw.rstrip("%"))
    except ValueError:
        fail(f"{column.flag}: '{raw}' no es un porcentaje"
             + (f" ni {list(column.tokens)}" if column.tokens else ""))
    if not 0 <= value <= 100:
        fail(f"{column.flag}: {value} fuera de rango 0-100")
    return f"{value:g}%"


def check_definition(schema, rows: list, relative: str) -> None:
    """Una serie append-only no se reescribe bajo otra definición de columnas."""
    expected = set(schema.keys)
    for number, row in enumerate(rows, start=1):
        if set(row) != expected:
            fail(f"{relative}:{number}: la fila fue escrita con otras columnas "
                 f"({sorted(row)}) y `metrics.columns` declara {sorted(expected)} — "
                 "una serie append-only no se reescribe bajo otra definición: la "
                 "migración de definiciones la ejecuta `/migrate`")


def main() -> None:
    config = kitconfig.load()
    columns = config.metric_columns
    positional, flags = parse_args(sys.argv[1:])

    if len(positional) != 1 or not is_valid_unit_id(config, positional[0]):
        fail(usage(config))
    unit_id = positional[0]

    known = {column.flag for column in columns} | {"--date"}
    unknown = sorted(set(flags) - known)
    if unknown:
        fail(f"flag(s) desconocida(s): {', '.join(unknown)}\n{usage(config)}")
    missing = [column.flag for column in columns if column.flag not in flags]
    if missing:
        fail(f"faltan flags: {', '.join(missing)}\n{usage(config)}")

    schema = reg.metrics_registry(config)
    relative = config.relative(store.data_path(config, schema))
    rows = store.read(config, schema)
    check_definition(schema, rows, relative)

    if any(row.get("unit") == unit_id for row in rows):
        print(f"AVISO: {unit_id} ya tiene fila(s) en {relative} — se agrega otra "
              "(append-only: la historia no se pisa).", file=sys.stderr)

    row = {"date": flags.get("--date", today()), "unit": unit_id}
    row.update({column.key: coerce(column, flags[column.flag]) for column in columns})
    store.append(config, "metrics", [row], COMMAND)
    print(f"{relative}: fila agregada para {unit_id} ({row['date']}) · vista "
          f"{config.relative(store.view_path(config, schema))} regenerada")


if __name__ == "__main__":
    main()
