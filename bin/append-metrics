#!/usr/bin/env python3
"""Close — una fila por cierre en `registry/metrics.md` (append-only).

Las columnas NO están hardcodeadas: salen de `metrics.columns` de
`framework.config.yaml`, con `metrics.version` sellada en el encabezado del
record. Si la definición cambió (versión distinta a la del archivo) el script
se detiene: reescribir un record append-only bajo otra definición falsifica la
serie — el cambio de definición lo ejecuta `/migrate`.

Tipos de columna: `percent` (0-100, con o sin `%`, más los `tokens` que la
columna declare, p. ej. `n/a`), `integer`, `text`.

Uso: append-metrics UNIT_ID --<columna> VALOR ... [--date YYYY-MM-DD]
"""
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from kitlib import config as kitconfig
from kitlib.dates import today
from kitlib.errors import fail
from kitlib.ids import is_valid_unit_id

VERSION_RE = re.compile(r"<!--\s*metrics-version:\s*(\d+)\s*-->")


def usage(config) -> str:
    flags = " ".join(f"{column.flag} VALOR" for column in config.metric_columns)
    return f"uso: append-metrics UNIT_ID {flags} [--date YYYY-MM-DD]"


def parse_args(argv: list[str]) -> tuple[list[str], dict]:
    flags, positional, index = {}, [], 0
    while index < len(argv):
        if argv[index].startswith("--"):
            if index + 1 >= len(argv):
                fail(f"{argv[index]} requiere valor")
            flags[argv[index]] = argv[index + 1]
            index += 2
        else:
            positional.append(argv[index])
            index += 1
    return positional, flags


def coerce(column, raw: str) -> str:
    if column.kind == "text":
        return raw
    if raw.lower() in {token.lower() for token in column.tokens}:
        return raw.lower()
    if column.kind == "integer":
        if not raw.isdigit():
            fail(f"{column.flag}: '{raw}' no es un entero"
                 + (f" ni {list(column.tokens)}" if column.tokens else ""))
        return raw
    try:
        value = float(raw.rstrip("%"))
    except ValueError:
        fail(f"{column.flag}: '{raw}' no es un porcentaje"
             + (f" ni {list(column.tokens)}" if column.tokens else ""))
    if not 0 <= value <= 100:
        fail(f"{column.flag}: {value} fuera de rango 0-100")
    return f"{value:g}%"


def check_version(path: Path, expected: int, relative: str) -> None:
    match = VERSION_RE.search(path.read_text(encoding="utf-8"))
    if not match:
        fail(f"{relative}: sin marca `<!-- metrics-version: N -->` — "
             "correr `kit-init` para sembrar el encabezado del record")
    if int(match.group(1)) != expected:
        fail(f"{relative}: el record fue abierto con metrics-version "
             f"{match.group(1)} y la config declara {expected} — una serie "
             "append-only no se reescribe bajo otra definición: la migración "
             "de definiciones la ejecuta `/migrate`")


def main() -> None:
    config = kitconfig.load()
    columns = config.metric_columns
    positional, flags = parse_args(sys.argv[1:])

    if len(positional) != 1 or not is_valid_unit_id(config, positional[0]):
        fail(usage(config))
    unit_id = positional[0]

    known = {column.flag for column in columns} | {"--date"}
    unknown = sorted(set(flags) - known)
    if unknown:
        fail(f"flag(s) desconocida(s): {', '.join(unknown)}\n{usage(config)}")
    missing = [column.flag for column in columns if column.flag not in flags]
    if missing:
        fail(f"faltan flags: {', '.join(missing)}\n{usage(config)}")

    metrics = config.registry_file("metrics")
    relative = config.relative(metrics)
    if not metrics.exists():
        fail(f"{relative}: no existe — correr `kit-init`")
    check_version(metrics, config.metrics_version, relative)

    values = [coerce(column, flags[column.flag]) for column in columns]
    date = flags.get("--date", today())
    text = metrics.read_text(encoding="utf-8")
    if f"| {unit_id} |" in text:
        print(f"AVISO: {unit_id} ya tiene fila(s) en {relative} — se agrega otra "
              "(append-only: la historia no se pisa).", file=sys.stderr)
    row = "| " + " | ".join([date, unit_id, *values]) + " |"
    metrics.write_text(text.rstrip("\n") + "\n" + row + "\n", encoding="utf-8")
    print(f"{relative}: fila agregada para {unit_id} ({date})")


if __name__ == "__main__":
    main()
